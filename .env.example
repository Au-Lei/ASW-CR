# Copy the synchronous webhook from the WPS AirScript editor, NOT a share link.
WPS_WEBHOOK_URL=
WPS_API_TOKEN=
WPS_SHEET_NAME=工作表1
# booking or bl; the original script used booking.
EVERGREEN_NUMBER_TYPE=booking
HEADLESS=true
# Maximum simultaneous queries (1-3); WPS writes stay serialized.
QUERY_CONCURRENCY=2
# Minimum global interval between starting queries, not an extra delay per order.
QUERY_INTERVAL_SECONDS=1
# Only needed for legacy month.day values; full dates are strongly preferred.
DATE_YEAR=2026
